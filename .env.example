# Public URL used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Back office (/admin). Both are required; the back office is disabled otherwise.
ADMIN_PASSWORD=change-me
# Random string of at least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=

# Where contribution requests are stored (JSON file). Defaults to ./storage/requests.json
# REQUESTS_DB_PATH=./storage/requests.json

# Set to 1 only when testing a production build over plain http on localhost.
# ADMIN_ALLOW_HTTP=1

# Supabase (required on Vercel; without it the site stores requests/edits in ./storage, local dev only)
# Dashboard → Project Settings → API: Project URL and the secret / service_role key. Keep the key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=item-images
